---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const siteUrl = 'https://jessbreatheandflow.com';
const circleDates = [
  { label: 'October 24, 2026', start: '2026-10-24T19:00:00-04:00', end: '2026-10-24T21:00:00-04:00', url: 'https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-october-24' },
  { label: 'November 28, 2026', start: '2026-11-28T19:00:00-05:00', end: '2026-11-28T21:00:00-05:00', url: 'https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-november-28' },
  { label: 'December 26, 2026', start: '2026-12-26T19:00:00-05:00', end: '2026-12-26T21:00:00-05:00', url: 'https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-december-26' },
];

const eventSchema = {
  '@context': 'https://schema.org',
  '@graph': circleDates.map((d) => ({
    '@type': 'Event',
    name: 'Full Moon Healing Circle, ' + d.label,
    description:
      'A circle held under the full moon for release, reflection, and community connection. Includes guided reflection, journaling, optional sharing, and a restorative sound bath.',
    startDate: d.start,
    endDate: d.end,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    image: siteUrl + '/images/full-moon-meditation.jpg',
    url: siteUrl + '/full-moon-circles',
    location: {
      '@type': 'Place',
      name: 'Milton, Massachusetts',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Milton',
        addressRegion: 'MA',
        addressCountry: 'US',
      },
    },
    organizer: { '@id': siteUrl + '/#organization' },
    performer: { '@id': siteUrl + '/#jessica' },
    offers: [
      { '@type': 'Offer', name: 'Sliding Scale', price: '11', priceCurrency: 'USD', url: d.url, availability: 'https://schema.org/InStock', validFrom: '2026-09-22' },
      { '@type': 'Offer', name: 'General Admission', price: '33', priceCurrency: 'USD', url: d.url, availability: 'https://schema.org/InStock', validFrom: '2026-09-22' },
      { '@type': 'Offer', name: 'Pay It Forward', price: '44', priceCurrency: 'USD', url: d.url, availability: 'https://schema.org/InStock', validFrom: '2026-09-22' },
    ],
  })),
};
---
<BaseLayout
  title="Full Moon Circles | Jess Breathe & Flow"
  description="Monthly Full Moon Healing Circles with Jess Breathe and Flow, held under the full moon for release, reflection, and community connection."
  path="/full-moon-circles"
  ctaText="Find Your Space"
  ctaHref="#dates"
  image="/images/full-moon-meditation.jpg"
  schema={eventSchema}
>
<section class="hero-split-full">
  <div class="hero-text">
    <h1>Full Moon Healing <span class="annotate annotate-underline">Circles<svg viewBox="0 0 200 20" preserveAspectRatio="none"><path d="M4 11 Q 50 3, 100 10 T 196 9"/></svg></span></h1>
    <p class="subhead">A circle held under the full moon, once a month, for release, reflection, and community connection. A space to set down what no longer serves you and step into what's next.</p>
    <p class="hero-tagline">Held once a month, sometimes twice when a blue moon calls for it.</p>
  </div>
  <div class="hero-image">
    <img src={base + "/images/full-moon-photo.jpg"} alt="Jessica smiling in an orange outfit, seated on stone steps surrounded by flowers" width="1200" height="1600" fetchpriority="high">
  </div>
</section>

<section class="section-tight">
  <div class="wrap center mx-auto" style="max-width: 720px;">
    <p class="eyebrow">What to expect</p>
    <h2>Ritual, not routine</h2>
    <p class="subhead mx-auto">Each circle follows the moon, not a fixed weekly schedule. That's intentional. The full moon has long been a marker for release and reflection, and this circle is built around that rhythm rather than around convenience.</p>
  </div>
  <div class="wrap">
    <div class="col-grid-4">
      <div class="reveal">
        <h3>Beginner-friendly</h3>
        <p>No prior experience with meditation or healing circles needed. You'll be gently guided every step of the way.</p>
      </div>
      <div class="reveal">
        <h3>Sharing is optional</h3>
        <p>You're invited to participate in whatever way feels safe and supportive. No one is required to speak.</p>
      </div>
      <div class="reveal">
        <h3>Guided reflection & sound</h3>
        <p>Expect guided reflection, journaling, optional sharing, and a restorative sound bath to support release and integration.</p>
      </div>
      <div class="reveal">
        <h3>All backgrounds welcome</h3>
        <p>This is a spiritual and reflective space, not a religious one, open to people of all backgrounds, beliefs, and identities.</p>
      </div>
    </div>
  </div>
</section>

<section class="tint-inner-light" id="dates">
  <div class="wrap center mx-auto" style="max-width: 720px;">
    <p class="eyebrow">Upcoming Circles</p>
    <h2>The next three dates</h2>
    <p class="subhead mx-auto">These are the only Full Moon Circles currently scheduled. Each is its own event, reserve early, seats are limited.</p>
  </div>

  <div class="wrap">
    <div class="stat-grid">
      <div class="stat-card big-number">
        <p class="big-num-label" style="color: var(--clay);">October 24</p>
        <p style="color: var(--deep-blue); margin: 8px 0 16px;">7:00 to 9:00 PM &middot; Milton, MA</p>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-october-24-slidingscale?date=2026-10-24&amp;month=2026-10" class="btn btn-secondary" style="margin-bottom:8px;">Sliding Scale &mdash; $11</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-october-24?date=2026-10-24&amp;month=2026-10" class="btn btn-primary" style="margin-bottom:8px;">General Admission &mdash; $33</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-october-24-payitforward?date=2026-10-24&amp;month=2026-10" class="btn btn-secondary">Pay It Forward &mdash; $44</a>
      </div>
      <div class="stat-card big-number">
        <p class="big-num-label" style="color: var(--clay);">November 28</p>
        <p style="color: var(--deep-blue); margin: 8px 0 16px;">7:00 to 9:00 PM &middot; Milton, MA</p>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-november-28-sliding-scale?date=2026-11-28&amp;month=2026-11" class="btn btn-secondary" style="margin-bottom:8px;">Sliding Scale &mdash; $11</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-november-28?date=2026-11-28&amp;month=2026-11" class="btn btn-primary" style="margin-bottom:8px;">General Admission &mdash; $33</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-november-28-pay-it-forward?date=2026-11-28&amp;month=2026-11" class="btn btn-secondary">Pay It Forward &mdash; $44</a>
      </div>
      <div class="stat-card big-number">
        <p class="big-num-label" style="color: var(--clay);">December 26</p>
        <p style="color: var(--deep-blue); margin: 8px 0 16px;">7:00 to 9:00 PM &middot; Milton, MA</p>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-december-26-sliding-scale?date=2026-12-26&amp;month=2026-12" class="btn btn-secondary" style="margin-bottom:8px;">Sliding Scale &mdash; $11</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-december-26?date=2026-12-26&amp;month=2026-12" class="btn btn-primary" style="margin-bottom:8px;">General Admission &mdash; $33</a>
        <a href="https://cal.com/jessica-metayer-1kh8sr/full-moon-circle-december-26-pay-it-forward-ticket?date=2026-12-26&amp;month=2026-12" class="btn btn-secondary">Pay It Forward &mdash; $44</a>
      </div>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap center mx-auto" style="max-width: 640px;">
    <p class="eyebrow">Pricing</p>
    <h2>Sliding scale, always</h2>
    <p class="subhead mx-auto">Cost should never be the reason someone can't be in the circle. Three tiers are available: $11 sliding scale, $33 general admission, and $44 pay-it-forward, which helps cover a sliding-scale seat for someone else.</p>
  </div>
</section>
</BaseLayout>
