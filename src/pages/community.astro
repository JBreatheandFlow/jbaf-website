---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title="Community | Jess Breathe & Flow"
  description="Monthly donation-based healing circles and standing weekly yoga classes across Greater Boston."
  path="/community"
>
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">Community</p>
    <h1>Healing that meets you where you <span class="annotate annotate-underline">already gather<svg viewBox="0 0 220 20" preserveAspectRatio="none"><path d="M4 11 Q 55 3, 110 10 T 216 9"/></svg></span>.</h1>
    <p class="subhead">We're deeply rooted in the Boston area, holding space for our communities in Milton, Dorchester, Roxbury, Cambridge, and beyond.</p>
  </div>
</section>

<section>
  <div class="wrap split">
    <div class="split-media"><img src={base + "/images/community-healing-circle.jpg"} alt="Jessica facilitating a donation-based healing circle" loading="lazy" width="1200" height="675"></div>
    <div class="split-copy">
      <p class="eyebrow">Monthly Circuit</p>
      <h2>Donation-based healing circles at local libraries</h2>
      <p>Open, accessible healing circles held monthly in community spaces across the Boston area, no experience required, donation-based so cost is never the barrier.</p>
      <p style="font-size:0.9rem; color: var(--clay); font-weight: 700;">Coming Soon</p>
      <p style="font-size:0.85rem; color: var(--stone);">We're working with local libraries to secure space and set recurring dates. Booking will open once those details are confirmed.</p>
    </div>
  </div>
</section>

<section class="tint-mist">
  <div class="wrap split reverse">
    <div class="split-copy">
      <p class="eyebrow" style="color: var(--inner-light);">Standing Class</p>
      <h2 style="color: var(--ivory);">Weekly community yoga</h2>
      <p style="color: var(--ivory); max-width: 56ch;">A standing weekly class for anyone ready to move, breathe, and connect. See Experiences for current times and to reserve a spot.</p>
      <a href={base + "/experiences"} class="btn btn-secondary" style="border-color: var(--ivory); color: var(--ivory);">See Experiences</a>
    </div>
    <div class="split-media"><img src={base + "/images/community-weekly-yoga.jpg"} alt="Jessica in seated meditation pose, hands in prayer" loading="lazy" width="1200" height="676"></div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap center mx-auto" style="max-width: 680px;">
    <p class="eyebrow">In progress</p>
    <h2>Building our first physical sanctuary</h2>
    <p class="mx-auto">Venue conversations are underway at several Boston-area locations. The DeWitt Center in Roxbury is furthest along, exploring a grant-funded model to make this space accessible to the community that needs it most.</p>
  </div>
</section>
</BaseLayout>
