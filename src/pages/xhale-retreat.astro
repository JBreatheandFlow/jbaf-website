---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title="Xhale Retreat | Jess Breathe & Flow"
  description="Xhale, a Jess Breathe and Flow retreat. May 1 to 8, 2027 at Samata Village, Gili Air, Indonesia."
  path="/xhale-retreat"
  ctaText="Join the Waitlist"
  ctaHref="https://form.typeform.com/to/qpcWBnwb"
  image="/images/xhale-hero-aerial.jpg"
>
<section class="hero-fullbleed">
  <img src={base + "/images/xhale-hero-aerial.jpg"} alt="Aerial view of the Xhale retreat pool and grounds in Gili Air, Indonesia" fetchpriority="high" decoding="async" width="1800" height="1013">
  <div class="hero-content">
    <p class="eyebrow">Jess Breathe & Flow presents</p>
    <h1>Xhale</h1>
    <p class="retreat-meta" style="font-family: var(--font-display); font-style: italic; font-size: 1.3rem; margin-bottom: 8px;">Come home to yourself.</p>
    <p class="retreat-meta">Samata Village, Gili Air, Indonesia<br>A 7-day wellness retreat &middot; May 1 &ndash; 8, 2027</p>
    <a href="https://form.typeform.com/to/qpcWBnwb" class="btn btn-primary">Join the Waitlist</a>
    <p style="color: var(--ivory); opacity: 0.85; font-size: 0.85rem; margin-top: 14px;">Registration opens soon.</p>
  </div>
</section>

<section class="section-tight">
  <div class="wrap center mx-auto" style="max-width: 680px;">
    <p class="eyebrow">A week to finally exhale</p>
    <h2>Come as you are. Leave lighter.</h2>
    <p class="subhead mx-auto">Seven days of yoga, sound healing, and community at Samata Village on the quiet island of Gili Air, no cars, no rush, just the ocean, the practice, and space to set some of it down. Registration hasn't opened yet. Join the waitlist and be the first to know the moment spots are released.</p>
    <a href="https://form.typeform.com/to/qpcWBnwb" class="btn btn-secondary">Join the Waitlist</a>
  </div>
</section>

<section class="section-tight tint-inner-light" id="gallery">
  <div class="wrap">
    <p class="eyebrow" style="text-align: center;">Samata Village</p>
    <h2 style="text-align: center; margin-bottom: 40px;">A look at where we'll gather</h2>
    <div class="gallery-grid">
      <div class="split-media"><img src={base + "/images/xhale-gallery-1.jpg"} alt="The retreat pool at dusk" loading="lazy" width="1200" height="799"></div>
      <div class="split-media"><img src={base + "/images/xhale-gallery-2.jpg"} alt="Poolside loungers surrounded by tropical gardens" loading="lazy" width="1200" height="800"></div>
      <div class="split-media"><img src={base + "/images/xhale-gallery-3.jpg"} alt="Red umbrellas along the pool deck" loading="lazy" width="1200" height="800"></div>
      <div class="split-media"><img src={base + "/images/xhale-gallery-4.jpg"} alt="View of the retreat grounds at sunset" loading="lazy" width="1000" height="666"></div>
      <div class="split-media"><img src={base + "/images/xhale-gallery-5.jpg"} alt="The pool surrounded by palm trees and thatched roofs" loading="lazy" width="1000" height="1000"></div>
      <div class="split-media"><img src={base + "/images/xhale-gallery-6.jpg"} alt="Aerial view of Samata Village and its pool" loading="lazy" width="1200" height="675"></div>
    </div>
  </div>
</section>
</BaseLayout>
