---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title="Experiences | Jess Breathe & Flow"
  description="Healing circles, sound baths, and community yoga. Every offering is ready to book today."
  path="/experiences"
  ctaText="Find Your Space"
  ctaHref="#full-moon"
>
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">Experiences</p>
    <h1>Find the experience that <span class="annotate annotate-underline">meets you where you are<svg viewBox="0 0 260 20" preserveAspectRatio="none"><path d="M4 11 Q 65 3, 130 10 T 256 9"/></svg></span>.</h1>
    <p class="subhead">Every offering below is ready to book today. Choose what your body and spirit are asking for.</p>
  </div>
</section>

<section class="tint-mist" id="full-moon">
  <div class="wrap split reverse">
    <div class="split-copy">
      <p class="eyebrow" style="color: var(--inner-light);">Monthly Circles</p>
      <h2 style="color: var(--ivory);">Full Moon Healing Circles</h2>
      <p style="color: var(--ivory); max-width: 56ch;">A circle held under the full moon for release, reflection, and community connection. Four dates are currently scheduled, each its own event, with sliding scale pricing so cost is never the barrier.</p>
      <a href={base + "/full-moon-circles"} class="btn btn-secondary" style="border-color: var(--ivory); color: var(--ivory);">See Upcoming Circles</a>
    </div>
    <div class="split-media"><img src={base + "/images/full-moon-photo.jpg"} alt="Jessica seated on stone steps surrounded by flowers" loading="lazy"></div>
  </div>
</section>

<section id="sound-bath">
  <div class="wrap split">
    <div class="split-media"><img src={base + "/images/sound-bath-bowls.jpg"} alt="Jessica playing crystal singing bowls during a sound bath" loading="lazy"></div>
    <div class="split-copy">
      <p class="eyebrow">Sound Bath</p>
      <h2>Sound Bath / Healing Meditation</h2>
      <p>A restorative sound bath and healing meditation session. Lie back, let go, and let the sound guide you home.</p>
      <p style="font-size:0.9rem; color: var(--stone);">30 to 60 minutes &middot; 20 seats &middot; pricing starts at $100+</p>
      <a href="https://cal.com/jessica-metayer-1kh8sr/sound-bath-healing-meditation" class="btn btn-primary">Reserve Your Spot</a>
    </div>
  </div>
</section>

<section class="tint-inner-light" id="yoga">
  <div class="wrap split reverse">
    <div class="split-copy">
      <p class="eyebrow">Community Yoga</p>
      <h2>Poolside Yoga</h2>
      <p>An outdoor, poolside yoga class open to all levels. Move, breathe, and connect in community.</p>
      <p style="font-size:0.9rem; color: var(--stone);">60 minutes &middot; 30 seats &middot; $20</p>
      <a href="https://cal.com/jessica-metayer-1kh8sr/poolside-yoga" class="btn btn-primary">Reserve Your Spot</a>
    </div>
    <div class="split-media"><img src={base + "/images/poolside-yoga-aerial.jpg"} alt="Aerial view of a poolside yoga class, participants on mats around the pool" loading="lazy"></div>
  </div>
</section>

<section id="private-yoga">
  <div class="wrap split">
    <div class="split-media"><img src={base + "/images/private-yoga-session.jpg"} alt="A one-on-one yoga session, deep backbend pose" loading="lazy"></div>
    <div class="split-copy">
      <p class="eyebrow">Private Sessions</p>
      <h2>Private Yoga Session</h2>
      <p>A one-on-one yoga session tailored to your body, goals, and pace. Fully personalized, no one else in the room.</p>
      <p style="font-size:0.9rem; color: var(--stone);">60 minutes &middot; $100</p>
      <a href="https://cal.com/jessica-metayer-1kh8sr/private-yoga-session" class="btn btn-primary">Reserve Your Spot</a>
    </div>
  </div>
</section>

<section class="tint-inner-light" id="semi-private-yoga">
  <div class="wrap split reverse">
    <div class="split-copy">
      <p class="eyebrow">Private Sessions</p>
      <h2>Semi-Private Yoga Session</h2>
      <p>A shared yoga session for you and a friend. Bring someone along and split the space, the pace stays personal.</p>
      <p style="font-size:0.9rem; color: var(--stone);">60 minutes &middot; $140 total for 2 people</p>
      <a href="https://cal.com/jessica-metayer-1kh8sr/semi-private-yoga-session" class="btn btn-primary">Reserve Your Spot</a>
    </div>
    <div class="split-media"><img src={base + "/images/semi-private-yoga.jpg"} alt="A yoga pigeon pose stretch" loading="lazy"></div>
  </div>
</section>

<section id="group-yoga">
  <div class="wrap split">
    <div class="split-media"><img src={base + "/images/poolside-yoga-aerial-2.jpg"} alt="Aerial view of a group yoga session" loading="lazy"></div>
    <div class="split-copy">
      <p class="eyebrow">Private Sessions</p>
      <h2>Group Yoga Session</h2>
      <p>Bring your people, up to 20 of them. A private session built for birthdays, team offsites, family gatherings, or any group that wants to move and breathe together.</p>
      <p style="font-size:0.9rem; color: var(--stone);">60 minutes &middot; Up to 20 people &middot; $300</p>
      <a href="https://cal.com/jessica-metayer-1kh8sr/group-yoga-session-up-to-20-people" class="btn btn-primary">Reserve Your Spot</a>
    </div>
  </div>
</section>

<section class="section-tight tint-mist" id="gallery">
  <div class="wrap">
    <p class="eyebrow" style="color: var(--inner-light); text-align: center;">Gallery</p>
    <h2 style="color: var(--ivory); text-align: center; margin-bottom: 40px;">A few moments from the practice</h2>
    <div class="gallery-grid">
      <div class="split-media"><img src={base + "/images/jessica-speaking.jpg"} alt="Jessica speaking at a community event" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-circle-2.jpg"} alt="A healing circle in community" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-bowls-closeup.jpg"} alt="Close up of crystal singing bowls" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-candles.jpg"} alt="Candlelit sound bath setup" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/crystal-altar.jpg"} alt="A crystal and candle altar" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-sunset-yoga.jpg"} alt="Silhouette in prayer pose at sunset" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-mountain-2.jpg"} alt="Prayer pose overlooking a mountain valley" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/gallery-yoga-twist.jpg"} alt="A seated yoga twist" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/about-graduation.jpg"} alt="Jessica at her graduate school graduation" loading="lazy"></div>
      <div class="split-media"><img src={base + "/images/poolside-yoga-aerial-2.jpg"} alt="Aerial view of a poolside yoga gathering" loading="lazy"></div>
    </div>
  </div>
</section>
</BaseLayout>
