---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div>
        <a href={base + '/'} class="logo"><img src={base + '/images/brand/logo-circle-reversed.svg'} alt="Jess Breathe & Flow"></a>
        <p class="footer-tagline">Enter as you. Emerge as your Self.</p>
      </div>
      <div class="footer-nav">
        <ul>
          <li><a href={base + '/experiences'}>Experiences</a></li>
          <li><a href={base + '/organizations'}>For Organizations</a></li>
          <li><a href={base + '/about'}>About Jess</a></li>
        </ul>
        <ul>
          <li><a href={base + '/research-insights'}>Research &amp; Insights</a></li>
          <li><a href={base + '/full-moon-circles'}>Full Moon Circles</a></li>
          <li><a href={base + '/#testimonials'}>Testimonials</a></li>
          <li><a href={base + '/faqs'}>FAQs</a></li>
          <li><a href={base + '/contact'}>Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; 2026 Jess Breathe &amp; Flow. Boston, MA.</span>
      <div class="footer-social">
        <a href="https://instagram.com/jessbreatheandflow" aria-label="Instagram" target="_blank" rel="noopener">Instagram</a>
        <a href="https://facebook.com/JessBreatheandFlow" aria-label="Facebook" target="_blank" rel="noopener">Facebook</a>
      </div>
    </div>
  </div>
</footer>
