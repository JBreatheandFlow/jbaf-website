---
const { ctaText = 'Find Your Space', ctaHref = '/experiences', path = '/' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p) => (p.startsWith('http') || p.startsWith('#') ? p : base + p);
const current = (p) => (path === p ? 'page' : undefined);
---
<header class="site-header">
  <div class="wrap">
    <a href={href('/')} class="logo" aria-current={current('/')}><img src={base + '/images/brand/logo-horizontal.svg'} alt="Jess Breathe & Flow"></a>
    <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span><span></span><span></span>
    </button>
    <nav aria-label="Primary">
      <ul class="main-nav" id="primary-nav">
        <li><a href={href('/experiences')} aria-current={current('/experiences')}>Experiences</a></li>
        <li><a href={href('/organizations')} aria-current={current('/organizations')}>For Organizations</a></li>
        <li><a href={href('/community')} aria-current={current('/community')}>Community</a></li>
        <li><a href={href('/xhale-retreat')} aria-current={current('/xhale-retreat')}>Xhale Retreat</a></li>
        <li><a href={href('/coaching')} aria-current={current('/coaching')}>Coaching</a></li>
        <li><a href={href('/about')} aria-current={current('/about')}>About</a></li>
        <li><a href={href(ctaHref)} class="nav-cta" target={ctaHref.startsWith("http") ? "_blank" : undefined} rel={ctaHref.startsWith("http") ? "noopener" : undefined}>{ctaText}</a></li>
      </ul>
    </nav>
  </div>
</header>
