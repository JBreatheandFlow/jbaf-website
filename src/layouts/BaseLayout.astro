---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  path = '/',
  ctaText,
  ctaHref,
  bodyClass = '',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://jessbreatheandflow.com';
const canonical = siteUrl + (path === '/' ? '/' : path);
const ogImage = siteUrl + '/images/brand/logo-circle-color.svg';
const plainTitle = title.replace(/&amp;/g, '&');
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Jess Breathe & Flow">
<meta property="og:title" content={plainTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={plainTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="stylesheet" href={base + '/style.css'}>
<slot name="head" />
</head>
<body class={bodyClass}>
<Header ctaText={ctaText} ctaHref={ctaHref} />
<slot />
<Footer />
<script src={base + '/flow.js'} defer></script>
</body>
</html>
